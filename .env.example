# ============================================================
# متغيرات بيئة مشروع Lumera
# انسخي هذا الملف باسم .env.local وعدّلي القيم عند الحاجة
# (لن يعمل المشروع بدون هذه الخطوة في بيئة الإنتاج - في وضع
# التطوير المحلي القيم الافتراضية كافية للتجربة)
# ============================================================

# مفتاح سري يُستخدم لتشفير جلسات الدخول (JWT).
# مهم جدًا: غيّري هذه القيمة إلى نص عشوائي طويل قبل النشر الفعلي.
# يمكنك توليد قيمة عشوائية بتشغيل هذا الأمر في الطرفية:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying

# مسار ملف قاعدة البيانات (اختياري - القيمة الافتراضية تعمل محليًا بدون تعديل)
# DATABASE_PATH=./data/lumera.db
DATABASE_URL="postgresql://neondb_owner:npg_64AbwrCYFMNH@ep-shiny-shape-b4rvf5a2-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"